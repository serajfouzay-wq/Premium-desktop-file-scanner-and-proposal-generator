{
  "name": "premium-desktop-file-scanner-and-proposal-generator",
  "productName": "Cabinet 2",
  "version": "2.0.0",
  "description": "Scans local documents, files them by company, and drafts premium proposals from what it finds.",
  "main": "electron/main.js",
  "author": "Cabinet",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5273 && cross-env NODE_ENV=development electron .\"",
    "dev:web": "vite",
    "build": "cross-env ELECTRON_BUILD=1 vite build",
    "start": "npm run build && npm run verify:desktop && electron .",
    "dist": "npm run build && npm run verify:desktop && electron-builder",
    "test:e2e": "xvfb-run -a electron test/e2e.js",
    "dist:win": "npm run build && npm run verify:desktop && electron-builder --win --x64",
    "build:sample": "node scripts/build-sample.js",
    "build:web": "vite build",
    "verify:desktop": "node scripts/verify-desktop-build.js",
    "test:classify": "node test/classify.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-sqlite3": "^11.7.0",
    "mammoth": "^1.8.0",
    "node-sqlite3-wasm": "^0.8.60",
    "pdfjs-dist": "^4.2.67",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "docx": "^9.7.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cabinet.desktop.v2",
    "productName": "Cabinet 2",
    "npmRebuild": false,
    "asar": false,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/better-sqlite3/**/*",
      "!node_modules/@napi-rs/**/*",
      "!**/node_modules/*/{test,__tests__,tests,example,examples,.bin}/**/*",
      "!**/*.{md,map,ts}"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "Cabinet-2-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "extraFiles": [
      {
        "from": "START-HERE.txt",
        "to": "START-HERE.txt"
      }
    ]
  }
}